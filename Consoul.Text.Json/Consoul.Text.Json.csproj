  <ItemGroup>
    <ProjectReference Include="..\Consoul\Consoul.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
