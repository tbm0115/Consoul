    <IsPackable>true</IsPackable>
    <Description>Optional System.Text.Json integration for Consoul form/object editor value rendering and JSON snapshots.</Description>
    <PackageTags>Console;Consoul;Terminal;Json;</PackageTags>
    <RootNamespace>ConsoulLibrary</RootNamespace>
