<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netcoreapp3.1;net461</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>A Console UI library for quickly building view-like Console Apps.</Description>
    <PackageTags>Console;Consoul;Terminal;</PackageTags>
    <RootNamespace>ConsoulLibrary</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Entry\Interfaces\**" />
    <EmbeddedResource Remove="Entry\Interfaces\**" />
    <None Remove="Entry\Interfaces\**" />
  </ItemGroup>


  <ItemGroup>
    <None Remove="Resources\Windows Ding.wav" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Windows Ding.wav" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Windows Ding.wav" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
