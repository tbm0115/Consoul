---
layout: null
permalink: /search.json
sitemap: false
---
[
{% assign guides = site.pages | where: 'searchable', true %}
{% for guide in guides %}
  {
    "title": {{ guide.title | jsonify }},
    "url": {{ guide.url | relative_url | jsonify }},
    "description": {{ guide.description | jsonify }},
    "text": {{ guide.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
