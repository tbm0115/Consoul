<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Optional command-line application helpers for Consoul MVC-style console apps.</Description>
    <PackageProjectUrl>https://github.com/tbm0115/Consoul</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tbm0115/Consoul</RepositoryUrl>
    <PackageTags>Console;Consoul;Terminal;Cli;CommandLine;</PackageTags>
    <Authors>tbm0115</Authors>
    <Company />
    <Version>2.0.2</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>2.0.2</AssemblyVersion>
    <FileVersion>2.0.2</FileVersion>
    <RootNamespace>ConsoulLibrary</RootNamespace>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Consoul\Consoul.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="README.md" />
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
